datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int         @id @default(autoincrement())
  username      String      @unique @db.VarChar(32)
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  characters    Character[]

  @@map("users")
}

model Character {
  id            Int             @id @default(autoincrement())
  user_id       Int
  user          User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name          String          @unique @db.VarChar(32)
  class_id      String          @db.VarChar(16)
  level         Int             @default(1)
  xp            Int             @default(0)
  strength      Int
  dexterity     Int
  intellect     Int
  vitality      Int
  luck          Int
  armor         Int
  talent_points Int             @default(0)
  talent_ranks  Json            @default("{}")
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  items         CharacterItem[]

  @@map("characters")
}

model CharacterItem {
  id           Int       @id @default(autoincrement())
  character_id Int
  character    Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
  item_id      String    @db.VarChar(32)
  slot         String?   @db.VarChar(16)

  @@unique([character_id, slot], map: "character_items_equip_slot")
  @@map("character_items")
}
