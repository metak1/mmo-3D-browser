generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int         @id @default(autoincrement())
  username      String      @unique @db.VarChar(32)
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  characters    Character[]

  @@map("users")
}

model Character {
  id              Int             @id @default(autoincrement())
  user_id         Int
  name            String          @unique @db.VarChar(32)
  class_id        String          @db.VarChar(16)
  level           Int             @default(1)
  xp              Int             @default(0)
  vitality        Int
  luck            Int
  armor           Int
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  talent_points   Int             @default(0)
  talent_ranks    Json            @default("{}")
  quest_progress  Json            @default("{}")
  quest_completed Json            @default("{}")
  main_stat       Int
  items           CharacterItem[]
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("characters")
}

model CharacterItem {
  id           Int       @id @default(autoincrement())
  character_id Int
  item_id      String    @db.VarChar(32)
  slot         String?   @db.VarChar(16)
  character    Character @relation(fields: [character_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("character_items")
}
